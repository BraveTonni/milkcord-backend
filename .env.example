# PostgreSQL connection
DB_USER=milkcord
DB_NAME=milkcord
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=change-me

# Server
APP_HOST=127.0.0.1
APP_PORT=7000
RELOAD=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Log SQL queries (dev only, keep false in production)
SQL_ECHO=false

# Application log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Max size of an uploaded file in bytes
MAX_UPLOAD_SIZE=10485760
